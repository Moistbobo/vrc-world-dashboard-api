# VRChat API credentials (used to fetch world data on add)
VRC_USERNAME=
VRC_PASSWORD=
VRC_TOTP_KEY=

# Comma-separated label terms used to extract world name / author name from
# plain-text tweets (Twitter/X world link resolution).
WORLD_NAME_MATCHERS=World:,World :,📸✨🌏World:,World name:,World,ワールド名
AUTHOR_NAME_MATCHERS=Author:,Author :,👤Author:,By:,Author,by

# LLM extraction fallback microservice (vrc-world-dashboard-llm-extractor).
# When regex extraction fails to find a world name, the API asks this service
# to extract it with an LLM. Leave empty to disable the fallback.
LLM_EXTRACTOR_URL=
LLM_EXTRACTOR_TIMEOUT_MS=10000

# API server config
API_PORT=3067
# API_HOST controls which interface the Express API binds to.
# Use 127.0.0.1 when running behind a reverse proxy like Caddy or Nginx.
API_HOST=127.0.0.1
# API tokens are stored in the SQLite database. Provision them with:
#   pnpm token:create -- --name <name> --role <role>
# Roles: viewer (read-only), curator (read + write), admin (same as curator today).
# See docs/API.md for the full CLI reference.
# Comma-separated list of allowed Origin values for CORS and origin validation.
# Supports '*' wildcards. Leave empty to allow any origin.
API_ALLOWED_ORIGINS=
# Comma-separated list of allowed source IP addresses for /api/* endpoints.
# Leave empty to skip IP allowlisting.
API_ALLOWED_IPS=

# Set to true to bypass the API origin and IP allowlists. Intended only for
# local development in a sandboxed environment. Equivalent to DEV=true.
DISABLE_API_RESTRICTIONS=false

# SQLite database path for world metadata storage
DATABASE_PATH=./worlds.db

# Postgres connection string. Required once the better-sqlite3 -> Postgres
# migration lands. Example: postgres://sos:sos@127.0.0.1:5432/sos_world_tagger
DATABASE_URL=

# Axiom log shipping (optional). Set AXIOM_TOKEN and AXIOM_DATASET to stream
# logs to Axiom; leave blank to skip shipping (e.g. local dev).
# AXIOM_EDGE is the edge domain for ingest, e.g. eu-central-1.aws.edge.axiom.co
# AXIOM_ORG_ID is only required when using a personal (not dataset) token.
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_EDGE=
AXIOM_ORG_ID=
