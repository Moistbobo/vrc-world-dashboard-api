{
  "exclude": ["dist", "tmp", "eslint.config.mts", "vitest.config.ts", "vitest.setup.ts", "perf"],
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "target": "es2021",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false
  },
  "lib": ["es2021"]
}
